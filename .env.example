# CodeOptimizer AI configuration (all values are optional).
# The agent uses the OpenCode CLI and whatever model/credentials the user
# already configured. No API keys belong in this file.

# Optional explicit model, in provider/model form. If unset, OpenCode's
# configured default model is used.
# CODEOPTIMIZER_MODEL=opencode/deepseek-v4.1-flash-free

# Seconds before a single model call is aborted.
CODEOPTIMIZER_LLM_TIMEOUT=300

# Default benchmark settings (can be overridden per repository with
# .codeoptimizer.json and per request through the API).
CODEOPTIMIZER_BENCHMARK_SIZE=3000
CODEOPTIMIZER_BENCHMARK_REPEATS=3
CODEOPTIMIZER_MIN_IMPROVEMENT_PCT=5

# Where isolated workspaces are created. Defaults to the OS temp directory.
# CODEOPTIMIZER_WORKSPACE_DIR=C:\temp\codeoptimizer-workspaces

# Optional explicit path to the OpenCode executable.
# CODEOPTIMIZER_OPENCODE_BIN=C:\Users\you\AppData\Roaming\npm\node_modules\@opencode\cli\bin\opencode.exe
